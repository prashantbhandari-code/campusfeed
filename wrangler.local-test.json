{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "campusfeed-local-test",
	"compatibility_date": "2026-10-13",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "ad2ac7ad100a4677bee3b109930e74ce"
		}
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "campusfeed-local-test"
		}
	],
	"images": {
		"binding": "IMAGES"
	}
}
