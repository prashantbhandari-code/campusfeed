generator client {
	provider        = "prisma-client-js"
	previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  appwriteId    String?   @unique
  name          String
  username      String    @unique
  email         String    @unique
  password      String
  avatar        String?
  bio           String?
  collegeEmail  String?   @unique
  rollNumber    String?   @unique
  phone         String?
  department    String?
  batchYear     Int?
  coverPhoto    String?
  verified      Boolean   @default(false)
  role          String    @default("student") // student, teacher, admin
  lastSeen      DateTime? // last activity timestamp for "active now" / "last seen" status
  createdAt     DateTime  @default(now())

  posts         Post[]
  comments      Comment[]
  likes         Like[]
  saves         Save[]
  stories       Story[]
  sentMessages     Message[] @relation("Sender")
  receivedMessages Message[] @relation("Receiver")
  messageReactions MessageReaction[]
  notifications    Notification[] @relation("NotifUser")
  notifFrom        Notification[] @relation("NotifFrom")

  followers     Follow[] @relation("Following")
  following     Follow[] @relation("Follower")
  groups        Group[]
  groupMembers  GroupMember[]
  groupMessages GroupMessage[]
  groupPosts    GroupPost[]
courses         Course[]
  createdSections Section[]
  assignments     Assignment[]
  submissions     Submission[]
  quizzes         Quiz[]
  quizAttempts    QuizAttempt[]
  courseMaterials  CourseMaterial[]
  grades          Grade[]
  sectionPosts  SectionPost[]
  enrollments   CourseEnrollment[]
  attendances   Attendance[]
  forumPosts    ForumPost[]
  forumReplies  ForumReply[]
  blogs         Blog[]
  blogComments  BlogComment[]
  createdEvents Event[]
  pushSubscriptions PushSubscription[]
  storyLikes     StoryLike[]
  storyComments  StoryComment[]
  passwordResetTokens PasswordResetToken[]

  blockedUsers   BlockedUser[] @relation("Blocker")
  blockedBy      BlockedUser[] @relation("Blocked")

  // Indexes for common queries
  @@index([email])
  @@index([username])
  @@index([department])
  @@index([batchYear])
  @@index([createdAt])

  @@map("users")
}

model Post {
  id        String   @id @default(uuid())
  content   String?
  images    String   @default("[]")
  authorId  String
  createdAt DateTime @default(now())

  author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments Comment[]
  likes    Like[]
  saves    Save[]

  // Indexes for feed queries
  @@index([authorId])
  @@index([createdAt])
  @@index([authorId, createdAt])

  @@map("posts")
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  postId    String
  authorId  String
  createdAt DateTime @default(now())
  editedAt  DateTime?

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // Indexes for comment queries
  @@index([postId])
  @@index([authorId])
  @@index([postId, createdAt])

  @@map("comments")
}

model Like {
  id     String @id @default(uuid())
  postId String
  userId String

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
  @@map("likes")
}

model Follow {
  id          String @id @default(uuid())
  followerId  String
  followingId String

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follows")
}

model Story {
  id        String   @id @default(uuid())
  images    String   @default("[]")
  authorId  String
  createdAt DateTime @default(now())
  expiresAt DateTime

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // Index for story expiry cleanup
  @@index([authorId])
  @@index([expiresAt])
  @@index([createdAt])

  likes    StoryLike[]
  comments StoryComment[]

  @@map("stories")
}

model Message {
  id         String   @id @default(uuid())
  content    String   @default("")
  senderId   String
  receiverId String
  fileUrl    String?
  fileType   String?
  fileName   String?
  read       Boolean  @default(false)
  readAt     DateTime?
  replyToId  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt // bumped on edits/deletes/reaction changes so device polls can find them

  // Edit / delete (WhatsApp-style)
  editedAt           DateTime?
  deletedForEveryone Boolean @default(false) // unsend: content cleared, both sides see a tombstone
  deletedForSender   Boolean @default(false) // "delete for me" when viewer is the sender
  deletedForReceiver Boolean @default(false) // "delete for me" when viewer is the receiver

  sender   User @relation("Sender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("Receiver", fields: [receiverId], references: [id], onDelete: Cascade)
  replyTo  Message?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies  Message[] @relation("MessageReplies")

  // Indexes for message queries
  @@index([senderId])
  @@index([receiverId])
  @@index([senderId, receiverId])
  @@index([receiverId, read])
  @@index([createdAt])
  @@index([updatedAt])
  reactions  MessageReaction[]

  @@map("messages")
}

model Save {
  id     String @id @default(uuid())
  postId String
  userId String

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
  @@map("saves")
}

model Notification {
  id         String   @id @default(uuid())
  type       String
  userId     String
  fromUserId String
  postId     String?
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  user     User @relation("NotifUser", fields: [userId], references: [id], onDelete: Cascade)
  fromUser User @relation("NotifFrom", fields: [fromUserId], references: [id], onDelete: Cascade)

  // Indexes for notification queries
  @@index([userId])
  @@index([userId, read])
  @@index([userId, createdAt])

  @@map("notifications")
}

// Ephemeral WebRTC signaling relay for the polling transport (Vercel).
// Rows live short: delivered inside a 30s window, deleted after 5 minutes.
model CallSignal {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  type       String // call-offer | call-answer | call-end | ice-candidate
  payload    Json
  createdAt  DateTime @default(now())

  @@index([receiverId, createdAt])
  @@map("call_signals")
}

model VerificationToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  type      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
  @@index([type])

  @@map("verification_tokens")
}

model BlockedUser {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])

  @@map("blocked_users")
}

model Group {
  id          String   @id @default(uuid())
  name        String
  description String?
  avatar      String?
  coverPhoto  String?
  type        String   @default("custom")
  department  String?
  batchYear   Int?
  section     String? // class section label, e.g. "A" for CSE-2027-Sec-A
  allowMemberPosts Boolean @default(true) // false = announcement mode (admins only)
  createdById String
  memberCount Int      @default(0)
  createdAt   DateTime @default(now())

  createdBy User            @relation(fields: [createdById], references: [id], onDelete: Cascade)
  members   GroupMember[]
  posts     GroupPost[]
  sections  Section[]
  messages  GroupMessage[]

  @@index([type])
  @@index([department])
  @@index([createdById])

  @@map("groups")
}

model GroupMember {
  id      String   @id @default(uuid())
  groupId String
  userId  String
  role    String   @default("member")
  lastReadAt DateTime? // group chat read marker for the unread badge
  joinedAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])

  @@map("group_members")
}

model GroupMessage {
  id        String   @id @default(uuid())
  content   String   @default("")
  fileUrl   String?
  fileType  String?
  fileName  String?
  groupId   String
  senderId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt // bumped on deletion so device polls can find the tombstone
  deletedForEveryone Boolean @default(false) // sender/admin unsend: content cleared, everyone sees a tombstone

  group  Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender User  @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
  @@index([updatedAt])

  @@map("group_messages")
}

model GroupPost {
  id        String   @id @default(uuid())
  content   String?
  images    String   @default("[]")
  groupId   String
  authorId  String
  createdAt DateTime @default(now())

  group  Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([authorId])
  @@index([groupId, createdAt])

  @@map("group_posts")
}

model Section {
  id          String   @id @default(uuid())
  name        String
  description String?
  icon        String?
  color       String?
  groupId     String
  order       Int      @default(0)
  createdById String
  createdAt   DateTime @default(now())

  group     Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy User        @relation(fields: [createdById], references: [id], onDelete: Cascade)
  posts     SectionPost[]

  @@index([groupId])
  @@index([groupId, order])

  @@map("sections")
}

model SectionPost {
  id        String   @id @default(uuid())
  content   String?
  images    String   @default("[]")
  sectionId String
  authorId  String
  createdAt DateTime @default(now())

  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([sectionId])
  @@index([authorId])
  @@index([sectionId, createdAt])

  @@map("section_posts")
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  location    String?
  startTime   DateTime
  endTime     DateTime?
  imageUrl    String?
  type        String   @default("meetup") // meetup, fest, workshop, seminar
  createdBy   String
  createdAt   DateTime @default(now())
  
  creator User @relation(fields: [createdBy], references: [id])
  
  @@index([startTime])
  @@index([createdBy])
}

model PushSubscription {
  id           String   @id @default(cuid())
  endpoint     String
  p256dh       String
  auth         String
  userId       String
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([endpoint])
}

model StoryLike {
  id        String   @id @default(uuid())
  userId    String
  storyId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([userId, storyId])
  @@index([storyId])
}

model StoryComment {
  id        String   @id @default(uuid())
  userId    String
  storyId   String
  content   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@index([storyId])
  @@index([userId])
}


model Course {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  description String?
  department  String?
  semester    Int?
  credits     Int      @default(3)
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator   User          @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  modules    CourseModule[]
  materials  CourseMaterial[]
  enrollments CourseEnrollment[]
  attendances Attendance[]
  forumPosts  ForumPost[]

  @@index([createdBy])
  @@index([department])
  @@index([semester])
  @@map("courses")
}

model CourseModule {
  id          String   @id @default(uuid())
  name        String
  description String?
  order       Int      @default(0)
  courseId     String
  createdAt   DateTime @default(now())

  course      Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  assignments Assignment[]
  quizzes     Quiz[]

  @@index([courseId])
  @@index([courseId, order])
  @@map("course_modules")
}

model Assignment {
  id          String   @id @default(uuid())
  title       String
  description String?
  moduleId    String
  dueDate     DateTime?
  maxScore    Int      @default(100)
  allowLate   Boolean  @default(false)
  createdBy   String
  createdAt   DateTime @default(now())

  module      CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  creator     User         @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@index([moduleId])
  @@index([createdBy])
  @@map("assignments")
}

model Submission {
  id          String   @id @default(uuid())
  assignmentId String
  studentId   String
  content     String?
  fileUrl     String?
  fileName    String?
  score       Int?
  feedback    String?
  status      String   @default("submitted")
  submittedAt DateTime @default(now())

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
  @@index([studentId])
  @@map("submissions")
}

model Quiz {
  id          String   @id @default(uuid())
  title       String
  description String?
  moduleId    String
  timeLimit   Int      @default(30)
  maxAttempts Int      @default(1)
  createdBy   String
  createdAt   DateTime @default(now())

  module    CourseModule  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  creator   User          @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@index([moduleId])
  @@index([createdBy])
  @@map("quizzes")
}

model QuizQuestion {
  id        String   @id @default(uuid())
  quizId    String
  question  String
  type      String   @default("multiple_choice")
  options   String   @default("[]")
  answer    String
  points    Int      @default(1)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  quiz     Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@map("quiz_questions")
}

model QuizAttempt {
  id        String   @id @default(uuid())
  quizId    String
  studentId String
  answers   String   @default("[]")
  score     Int      @default(0)
  completed Boolean  @default(false)
  startedAt DateTime @default(now())
  endedAt   DateTime?

  quiz    Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@index([studentId])
  @@map("quiz_attempts")
}

model CourseMaterial {
  id        String   @id @default(uuid())
  courseId   String
  title     String
  fileUrl   String
  fileName  String
  fileType  String?
  uploadedBy String
  createdAt DateTime @default(now())

  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  uploader User   @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([uploadedBy])
  @@map("course_materials")
}

model Grade {
  id        String   @id @default(uuid())
  courseId   String
  studentId String
  assignmentId String?
  quizId    String?
  score     Int
  maxScore  Int
  comment   String?
  createdAt DateTime @default(now())

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([studentId])
  @@index([courseId, studentId])
  @@map("grades")
}

model CourseEnrollment {
  id        String   @id @default(uuid())
  courseId   String
  studentId String
  role      String   @default("student") // student, teaching_assistant
  status    String   @default("active")  // active, dropped, completed
  enrolledAt DateTime @default(now())

  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId])
  @@index([courseId])
  @@index([studentId])
  @@map("course_enrollments")
}

model Attendance {
  id        String   @id @default(uuid())
  courseId   String
  studentId String
  date      DateTime @default(now())
  status    String   @default("present") // present, absent, late, excused
  markedBy  String?
  qrCode    String?
  notes     String?
  createdAt DateTime @default(now())

  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId, date])
  @@index([courseId])
  @@index([studentId])
  @@index([courseId, date])
  @@map("attendances")
}

model ForumPost {
  id        String   @id @default(uuid())
  courseId   String
  authorId  String
  title     String
  content   String
  pinned    Boolean  @default(false)
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course  Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  author  User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replies ForumReply[]

  @@index([courseId])
  @@index([authorId])
  @@index([courseId, createdAt])
  @@map("forum_posts")
}

model ForumReply {
  id        String   @id @default(uuid())
  postId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post   ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([authorId])
  @@index([postId, createdAt])
  @@map("forum_replies")
}

// Long-form campus blogs — separate from the feed's Post (no title, short
// content) so blogs stay out of the feed and feed posts stay out of /blogs.
model Blog {
  id        String   @id @default(uuid())
  title     String
  content   String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author   User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments BlogComment[]

  @@index([authorId])
  @@index([createdAt])

  @@map("blogs")
}

model BlogComment {
  id        String   @id @default(uuid())
  content   String
  blogId    String
  authorId  String
  createdAt DateTime @default(now())

  blog   Blog @relation(fields: [blogId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([blogId])
  @@index([blogId, createdAt])

  @@map("blog_comments")
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}
model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
}
