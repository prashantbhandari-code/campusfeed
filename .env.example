# === Database (Prisma + PostgreSQL) ===
DATABASE_URL=postgresql://user:password@host:5432/dbname

# === Appwrite (Auth + Storage) ===
# Auth no longer runs through Appwrite (email login is bcrypt against
# Postgres; Google OAuth talks to Google directly). These are still required
# for file uploads: /api/upload writes to Appwrite Storage with the API key.
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=your-project-id
APPWRITE_API_KEY=your-server-api-key

# === Session signing ===
# HMAC secret for the cc_session cookie. Set this explicitly — if absent it
# falls back to NEXTAUTH_SECRET, then APPWRITE_API_KEY, and session validity
# would then be tied to that key's lifecycle.
SESSION_SECRET=generate-a-long-random-string

# === Google OAuth ===
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# === Socket.IO (real-time messaging) ===
SOCKET_PORT=3001

# === Push Notifications (Web Push) ===
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# === Calls (WebRTC) ===
# Cross-network calls need a working TURN relay: the built-in free OpenRelay
# no longer issues relay candidates, so two CGNAT networks (mobile data,
# campus WiFi) can't connect. Preferred fix — Cloudflare Calls TURN
# (1TB/month free tier): create a TURN app at dash.cloudflare.com (Calls),
# then set the two values it shows:
#   CLOUDFLARE_TURN_TOKEN_ID=<Key ID>
#   CLOUDFLARE_TURN_TOKEN_SECRET=<Secret>
# /api/ice-servers signs 6-hour credentials from these; the secret stays
# server-side. Redeploy after setting. Alternative static override
# (build-time, creds visible to clients):
# NEXT_PUBLIC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":["turn:your-host:3478?transport=tcp"],"username":"u","credential":"c"}]

# === Next.js ===
NEXTAUTH_URL=https://campusfeed-prashantbhandari-code.vercel.app
NODE_ENV=production
