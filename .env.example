# === Database (Prisma + PostgreSQL) ===
DATABASE_URL=postgresql://user:password@host:5432/dbname

# === Appwrite (Auth + Storage) ===
# Auth no longer runs through Appwrite (email login is bcrypt against
# Postgres; Google OAuth talks to Google directly). These are still required
# for file uploads: /api/upload writes to Appwrite Storage with the API key.
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=your-project-id
APPWRITE_API_KEY=your-server-api-key

# === Session signing ===
# HMAC secret for the cc_session cookie. Set this explicitly to a long random
# value. If it is absent or set to the literal "[SENSITIVE]" placeholder the
# app throws rather than signing sessions with a guessable key. Rotating this
# value invalidates every existing session — that is the only way to revoke a
# leaked token, so rotate immediately if a cc_session cookie ever leaks.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=generate-a-long-random-string

# === Rate limiting (Upstash Redis) ===
# Both are required for real rate limiting. If they are absent the app falls
# back to an in-process limiter: limits still apply, but per-instance and reset
# on restart, so a caller behind multiple instances gets a multiple of the
# configured limit. Free tier is plenty for this app.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# === Google OAuth ===
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# === Socket.IO (real-time messaging) ===
SOCKET_PORT=3001

# === Push Notifications (Web Push) ===
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# === Calls (WebRTC) ===
# Cross-network calls need a working TURN relay: the built-in free OpenRelay
# no longer issues relay candidates, so two CGNAT networks (mobile data,
# campus WiFi) can't connect. Preferred fix — Cloudflare Calls TURN
# (1TB/month free tier): create a TURN app at dash.cloudflare.com (Calls),
# then set the two values it shows:
#   CLOUDFLARE_TURN_TOKEN_ID=<Key ID>
#   CLOUDFLARE_TURN_TOKEN_SECRET=<Secret>
# /api/ice-servers proxies Cloudflare's official credentials endpoint with
# the key secret as Bearer (24h ttl); the secret stays server-side. Both vars
# are required — the Key ID names the key, the Secret authenticates the call. Alternative static override
# (build-time, creds visible to clients):
# NEXT_PUBLIC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":["turn:your-host:3478?transport=tcp"],"username":"u","credential":"c"}]

# === Next.js ===
NEXTAUTH_URL=https://campusfeed-prashantbhandari-code.vercel.app
NODE_ENV=production
