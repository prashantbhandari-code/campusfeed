{
  "appId": "com.campusconnect.kiit",
  "appName": "CampusConnect",
  "webDir": "out",
  "server": {
    "androidScheme": "https",
    "url": "https://campusconnect-osm1.onrender.com",
    "cleartext": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2500,
      "backgroundColor": "#0a0a1a",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": true,
      "spinnerColor": "#2563eb"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0a0a1a"
    }
  }
}
